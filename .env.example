# =============================================================================
# Copy to .env for local development, and set the same keys in the Vercel
# dashboard for production. `.env` and `.env.local` are gitignored; this file is
# the only committed example and must never contain a real key.
# =============================================================================

# --- Client -----------------------------------------------------------------
# Values prefixed VITE_ are inlined into the browser bundle at build time.
# Never put a secret here.

# Which adapter the browser resolves. `openrouter` (default) or `puter`.
VITE_AI_PROVIDER=openrouter

# Optional. The backend enforces its own allowlist, so an unknown id is rejected
# with 403 MODEL_NOT_ALLOWED rather than silently billed.
# VITE_AI_MODEL=openai/gpt-4o-mini

# Google OAuth *client* ID (NOT a client secret). Create it at
# console.cloud.google.com -> APIs & Services -> Credentials ->
# "Create Credentials" -> "OAuth client ID" -> "Web application", then add your
# deployment origin under "Authorized JavaScript origins".
# Public by design: it identifies the app to Google, it grants nothing.
# VITE_GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com

# --- Server (api/chat.ts, api/auth/*.ts Edge Functions) ---------------------
# Never exposed to the browser. Read via process.env on every request.

# Required when VITE_AI_PROVIDER=openrouter. Get one at openrouter.ai/keys
OPENROUTER_API_KEY=

# Default model when the client does not name one.
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Comma-separated allowlist of models a client may request.
# OPENROUTER_ALLOWED_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-haiku

# Tried in order when the primary model fails, filtered against the allowlist and
# sent to OpenRouter as its `models` array. Without this a single model outage
# is a user-visible outage.
# OPENROUTER_FALLBACK_MODELS=anthropic/claude-3.5-haiku,google/gemini-flash-1.5

# Token bucket: burst size and sustained requests per minute, per client IP.
# AI_RATE_LIMIT_CAPACITY=20
# AI_RATE_LIMIT_PER_MINUTE=20

# --- Distributed rate limiting ----------------------------------------------
#
# Without these the limiter is per-Edge-isolate, so a deployment with N warm
# isolates effectively allows N x the numbers above. Setting both makes the
# bucket global. Both are required; one alone is ignored.
#
# Upstash Redis (REST, because Edge Functions have no raw sockets):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# If Redis is unreachable the limiter degrades to the local bucket and emits a
# `rate_limit_store_unavailable` alert. Set this to `false` to deny instead —
# right when the limit is load-bearing for cost, wrong when it is only an abuse
# control, since a Redis outage then becomes a product outage.
# RATE_LIMIT_FAIL_OPEN=true

# --- Cost containment -------------------------------------------------------

# Per-principal daily token budget (UTC day). Each request reserves its estimated
# input plus `max_tokens` before the call, then reconciles against the usage the
# provider reports. Exceeding it returns 429 BUDGET_EXCEEDED with a Retry-After.
# Default 500000. This is the backstop against an unbounded bill.
# AI_DAILY_TOKEN_BUDGET=500000

# --- Logging ----------------------------------------------------------------

# Salt for hashing principals in request logs and in the audit-trail pseudonym
# written on account deletion. Set it and it stays deployment-specific; leave it
# unset and the hashes are reproducible by anyone who reads the source.
# Generate one the same way as SESSION_SECRET.
LOG_SALT=

# Each AI request emits one JSON line to stdout:
#   traceId, principal (salted hash), model, promptVersion, stream, inputChars,
#   inputTokens, outputTokens, totalTokens, latencyMs, status, errorCode
# Prompt text, completions and note content are deliberately not fields on that
# record, and a test asserts the exact key set so adding one fails CI.

# Sent to OpenRouter as HTTP-Referer for attribution and routing.
# APP_BASE_URL=https://your-app.vercel.app

# --- Note sync (Phase 1) ----------------------------------------------------

# Pooled Postgres connection string. Required for /api/notes and
# /api/notes/sync; without it those endpoints return 503 SYNC_NOT_CONFIGURED
# and the app silently stays local-only.
#
# Neon:      postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
# Vercel:    the pooled connection string from the Postgres dashboard
DATABASE_URL=

# Apply the schema with: npx drizzle-kit push
#
# Migrations in server/db/migrations: 0000_init.sql creates the tables,
# 0001_search_and_audit.sql adds note search and the sign-in audit log. The
# latter runs `CREATE EXTENSION IF NOT EXISTS pg_trgm`, which needs a role with
# extension privileges on your database. Without it /api/notes/search,
# /api/auth/events and /api/auth/account all return 503 and the app stays
# local-only.

# --- Authentication ---------------------------------------------------------

# Must equal VITE_GOOGLE_CLIENT_ID. The server checks the ID token's `aud`
# claim against it, so a mismatch rejects every sign-in with 401.
GOOGLE_CLIENT_ID=

# Signs the session cookie (HS256). Minimum 32 bytes; the server refuses to
# start auth without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it invalidates every existing session.
SESSION_SECRET=

# Set to `true` to require sign-in before any AI request. Anonymous visitors
# are otherwise rate limited per IP; signed-in users are limited per account.
# REQUIRE_AUTH_FOR_AI=false
